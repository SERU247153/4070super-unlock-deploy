{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "title": "GPU 사용률",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "min": 0}}
    },
    {
      "title": "GPU 온도",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "GPU {{gpu}}"}],
      "fieldConfig": {"defaults": {"unit": "celsius"}}
    },
    {
      "title": "전력 소비",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "GPU {{gpu}}"}],
      "fieldConfig": {"defaults": {"unit": "watt"}}
    },
    {
      "title": "VRAM 사용량",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "GPU {{gpu}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "title": "SM 클럭",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "DCGM_FI_DEV_SM_CLOCK", "legendFormat": "GPU {{gpu}}"}],
      "fieldConfig": {"defaults": {"unit": "megahertz"}}
    },
    {
      "title": "판정 지연 (엣지 보고, ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "edge_decision_ms", "legendFormat": "node {{node}}"}],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "title": "Edge AI GPU 모니터링",
  "uid": "edge-gpu-mon",
  "version": 1
